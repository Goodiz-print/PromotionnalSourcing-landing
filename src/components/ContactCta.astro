---
import Button from './Button.astro'
import { useTranslations } from '../i18n/utils'

interface Props {
  /** `on-dark` pour la section CTA à fond dégradé, `default` pour la page /contact. */
  variant?: 'default' | 'on-dark'
}

const { variant = 'default' } = Astro.props

const t = useTranslations(Astro.currentLocale)

const EMAIL = 'contact@promotional-sourcing.eu'

/* Le formulaire qualifiait la demande via ses champs ; le corps pré-rempli reprend les
   mêmes questions pour ne pas perdre cette qualification en passant au mailto.
   RFC 6068 : les sauts de ligne du corps doivent être des CRLF, sinon certains clients
   (Outlook notamment) collent toutes les lignes bout à bout. */
const mailBody = t('contact.mailBody').replace(/\n/g, '\r\n')
const mailtoHref = `mailto:${EMAIL}?subject=${encodeURIComponent(t('contact.mailSubject'))}&body=${encodeURIComponent(mailBody)}`

const onDark = variant === 'on-dark'
const hintClass = onDark ? 'text-caption text-indigo-100' : 'text-caption text-text-muted'
const linkClass = onDark
  ? 'font-semibold text-white underline underline-offset-2'
  : 'font-semibold text-text-brand underline underline-offset-2'
---

{
	onDark ? (
		<div class="flex flex-col items-center gap-5">
			<Button href={mailtoHref} variant="on-dark">
				{t('contact.mailCta')} <span aria-hidden="true">→</span>
			</Button>
			<p class={hintClass}>
				{t('contact.mailFallback')}{' '}
				<a class={linkClass} href={`mailto:${EMAIL}`}>
					{EMAIL}
				</a>
			</p>
		</div>
	) : (
		<div class="max-w-[620px]">
			<p class="text-body-md text-text-secondary">{t('contact.mailIntro')}</p>
			<ul class="mt-5 mb-8 flex flex-col gap-3">
				{t('contact.mailPoints').map((point) => (
					<li class="flex gap-3 text-body-md text-text-secondary">
						<span class="mt-[7px] h-1.5 w-1.5 shrink-0 rounded-full bg-indigo-500" aria-hidden="true" />
						{point}
					</li>
				))}
			</ul>
			<Button href={mailtoHref} variant="primary">
				{t('contact.mailCta')} <span aria-hidden="true">→</span>
			</Button>
			<p class={`mt-4 ${hintClass}`}>{t('contact.mailHint')}</p>
		</div>
	)
}
