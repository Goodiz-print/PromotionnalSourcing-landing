---
import Button from './Button.astro'
import { useTranslations } from '../i18n/utils'
import { localizedPath } from '../i18n/routes'
import { defaultLang } from '../i18n/ui'

interface Props {
  /** `on-dark` pour la section CTA à fond dégradé, `default` pour la page /contact. */
  variant?: 'default' | 'on-dark'
  /** Suffixe des id/for : deux formulaires coexistent sur la home, les id doivent rester uniques. */
  idPrefix?: string
}

const { variant = 'default', idPrefix = variant } = Astro.props

const t = useTranslations(Astro.currentLocale)
const lang = Astro.currentLocale ?? defaultLang

/* Un seul nom de formulaire partagé par les 4 rendus (fr/en × home et /contact) :
   toutes les soumissions arrivent dans la même boîte Netlify. */
const FORM_NAME = 'contact'

const onDark = variant === 'on-dark'
const labelClass = onDark
  ? 'mb-1.5 block text-body-sm font-semibold text-white'
  : 'mb-1.5 block text-body-sm font-semibold text-text-primary'
const optionalClass = onDark ? 'font-normal text-indigo-100' : 'font-normal text-text-muted'
const hintClass = onDark ? 'text-caption text-indigo-100' : 'text-caption text-text-muted'
const linkClass = onDark ? 'underline underline-offset-2' : 'text-text-brand underline underline-offset-2'

const id = (name: string) => `${idPrefix}-${name}`
---

<form
	name={FORM_NAME}
	method="POST"
	data-netlify="true"
	netlify-honeypot="bot-field"
	action={localizedPath('thanks', lang)}
	class="mx-auto w-full max-w-[620px] text-left"
>
	{/* Requis par Netlify : la valeur doit être identique à l'attribut name du formulaire. */}
	<input type="hidden" name="form-name" value={FORM_NAME} />
	<input type="hidden" name="locale" value={lang} />

	{/* Piège à bots : masqué visuellement et retiré de l'ordre de tabulation. */}
	<p class="hidden">
		<label>{t('contact.honeypot')} <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
	</p>

	<div class="grid gap-4 sm:grid-cols-2">
		<div>
			<label class={labelClass} for={id('name')}>{t('contact.fieldName')} *</label>
			<input class="field-control" type="text" id={id('name')} name="name" required autocomplete="name" />
		</div>
		<div>
			<label class={labelClass} for={id('company')}>{t('contact.fieldCompany')} *</label>
			<input class="field-control" type="text" id={id('company')} name="company" required autocomplete="organization" />
		</div>
		<div>
			<label class={labelClass} for={id('email')}>{t('contact.fieldEmail')} *</label>
			<input class="field-control" type="email" id={id('email')} name="email" required autocomplete="email" />
		</div>
		<div>
			<label class={labelClass} for={id('phone')}>
				{t('contact.fieldPhone')} <span class={optionalClass}>({t('contact.fieldPhoneOptional')})</span>
			</label>
			<input class="field-control" type="tel" id={id('phone')} name="phone" autocomplete="tel" />
		</div>
		<div class="sm:col-span-2">
			<label class={labelClass} for={id('role')}>{t('contact.fieldRole')} *</label>
			<select class="field-control" id={id('role')} name="role" required>
				<option value="" disabled selected>{t('contact.fieldRolePlaceholder')}</option>
				<option value="agence">{t('contact.fieldRoleAgency')}</option>
				<option value="fournisseur">{t('contact.fieldRoleSupplier')}</option>
				<option value="autre">{t('contact.fieldRoleOther')}</option>
			</select>
		</div>
		<div class="sm:col-span-2">
			<label class={labelClass} for={id('message')}>{t('contact.fieldMessage')} *</label>
			<textarea
				class="field-control resize-y"
				id={id('message')}
				name="message"
				required
				rows="5"
				placeholder={t('contact.fieldMessagePlaceholder')}></textarea>
		</div>
	</div>

	<p class={`mt-3 ${hintClass}`}>{t('contact.requiredHint')}</p>

	<div class="mt-6 flex flex-wrap items-center justify-center gap-4 sm:justify-start">
		<Button type="submit" variant={onDark ? 'on-dark' : 'primary'}>{t('contact.submit')}</Button>
		<p class={`max-w-[320px] ${hintClass}`}>
			{t('contact.privacyBefore')}<a class={linkClass} href={localizedPath('privacy', lang)}>{t('contact.privacyLink')}</a
			>{t('contact.privacyAfter')}
		</p>
	</div>
</form>
