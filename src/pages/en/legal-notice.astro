---
import LegalLayout from '../../layouts/LegalLayout.astro'
import LegalSection from '../../components/LegalSection.astro'
import { useTranslations } from '../../i18n/utils'
import { localizedPath } from '../../i18n/routes'

const t = useTranslations(Astro.currentLocale)
const lang = Astro.currentLocale
const email = 'contact@promotional-sourcing.eu'

const sections = [
  { id: 'publisher', title: 'Website publisher' },
  { id: 'registered-office', title: 'Registered office' },
  { id: 'registration', title: 'Company registration' },
  { id: 'vat', title: 'VAT number' },
  { id: 'activity', title: 'Business activity' },
  { id: 'host', title: 'Website host' },
  { id: 'contact', title: 'Contact us' },
  { id: 'intellectual-property', title: 'Intellectual property' },
  { id: 'personal-data', title: 'Personal data' },
] as const
---

<LegalLayout
	title={t('legal.seoTitle')}
	description={t('legal.seoDescription')}
	heading="Legal notice"
	eyebrow="Legal information"
	intro="Who publishes and hosts promotional-sourcing.eu, and the rules that apply to its content."
	route="legal"
	updatedAt="7 August 2026"
	sections={sections}
>
	<LegalSection sections={sections} id="publisher">
		<p>
			PROMOTIONAL SOURCING, société par actions simplifiée (French simplified joint-stock company)
		</p>
		<p>Website: promotional-sourcing.eu</p>
	</LegalSection>

	<LegalSection sections={sections} id="registered-office">
		<address>
			PROMOTIONAL SOURCING<br />
			72 quai de Bacalan<br />
			33300 Bordeaux — France
		</address>
	</LegalSection>

	<LegalSection sections={sections} id="registration">
		<p>
			SIREN 108 093 790 — Bordeaux Trade and Companies Register<br />
			SIRET (registered office): 108 093 790 00013<br />
			NAF/APE code: 6312Z — Web portals
		</p>
	</LegalSection>

	<LegalSection sections={sections} id="vat">
		<p>Intra-community VAT number: FR03 108 093 790</p>
	</LegalSection>

	<LegalSection sections={sections} id="activity">
		<p>
			Publishing and operating a web platform for sourcing promotional products, connecting
			professional buyers with suppliers.
		</p>
	</LegalSection>

	<LegalSection sections={sections} id="host">
		<address>
			Netlify, Inc.<br />
			512 2nd Street, Suite 200<br />
			San Francisco, CA 94107 — United States<br />
			<a href="https://www.netlify.com" rel="noopener noreferrer" target="_blank">netlify.com</a>
		</address>
	</LegalSection>

	<LegalSection sections={sections} id="contact">
		<p>Email: <a href={`mailto:${email}`}>{email}</a></p>
	</LegalSection>

	<LegalSection sections={sections} id="intellectual-property">
		<p>
			All elements making up the promotional-sourcing.eu website (text, graphics, logos, images,
			structure) are the exclusive property of PROMOTIONAL SOURCING or are used under licence. Any
			reproduction, representation or distribution, in whole or in part, without prior written
			authorisation is prohibited and constitutes infringement under Articles L.335-2 et seq. of the
			French Intellectual Property Code.
		</p>
	</LegalSection>

	<LegalSection sections={sections} id="personal-data">
		<p>
			PROMOTIONAL SOURCING attaches great importance to the protection and security of your personal
			data. To find out more about how your data is collected and processed, please read our
			<a href={localizedPath('privacy', lang)}>Privacy policy</a>.
		</p>
	</LegalSection>
</LegalLayout>
